{
  "name": "visa-appointment-tracker",
  "version": "0.1.0",
  "main": "./dist/src/index.js",
  "repository": "https://github.com/dhyegocalota/visa-appointment-tracker",
  "author": "Dhyego Calota <dhyegofernando@gmail.com>",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "prepare": "ts-patch install -s",
    "serve": "NODE_ENV=development nodemon --watch './' --exec 'ts-node -r tsconfig-paths/register --files ./src/bin/cron.ts' -e ts",
    "start": "pm2-runtime start ./dist/bin/cron.js --env production",
    "build": "tspc",
    "heroku-postbuild": "node patch-workflow.js"
  },
  "devDependencies": {
    "@types/lodash.merge": "^4.6.7",
    "@types/node-cron": "^3.0.1",
    "logform": "^2.4.0",
    "nodemon": "^2.0.16",
    "ts-node": "^10.8.1",
    "ts-patch": "^3.0.0",
    "tsconfig-paths": "^3.12.0",
    "typescript": "^5.0.0",
    "typescript-transform-paths": "^3.3.1"
  },
  "dependencies": {
    "@lifeomic/attempt": "^3.0.3",
    "date-fns": "^2.28.0",
    "dotenv": "^16.0.1",
    "eta": "^4.6.0",
    "lodash.merge": "^4.6.2",
    "node-cron": "^3.0.1",
    "pm2": "^6.0.14",
    "puppeteer": "^25.1.0",
    "safe-stable-stringify": "^2.3.1",
    "twilio": "^6.0.2",
    "uuid": "^14.0.0",
    "winston": "^3.7.2"
  }
}